# Copier ce fichier en `.env.local` puis renseigner les valeurs.
# `.env.local` est ignoré par git : aucun secret ne doit être commité.

# ─── Authentification (NextAuth v5) ──────────────────────────────────────────
# Secret de signature des jetons de session. Obligatoire.
# Générer une valeur avec :  npx auth secret
AUTH_SECRET=

# ─── Source de données ───────────────────────────────────────────────────────
# "true" (défaut) : la console lit les jeux de données locaux (src/app/*/data.json)
# "false"         : la console interroge l'API FastAPI définie ci-dessous
NEXT_PUBLIC_USE_MOCK=true

# URL de base de l'API. Utilisée uniquement quand NEXT_PUBLIC_USE_MOCK=false.
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
